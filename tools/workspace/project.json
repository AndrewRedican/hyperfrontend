{
  "name": "tool-workspace",
  "description": "The workspace's own command line, dependency graph and pipeline, and the executors behind the root project's targets.",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "tags": ["type:util", "scope:internal"],
  "targets": {
    "test": {},
    "typecheck": {},
    "graph": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import ./tools/lint/src/runtime/aliases.ts tools/workspace/bin/graph.ts"
      }
    },
    "pipeline": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import ./tools/lint/src/runtime/aliases.ts tools/workspace/bin/pipeline.ts"
      }
    },
    "types-extract": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import ./tools/lint/src/runtime/aliases.ts tools/workspace/bin/types-extract.ts"
      }
    },
    "types-extract-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --import ./tools/lint/src/runtime/aliases.ts tools/workspace/bin/types-extract.ts --check"
      }
    }
  }
}

{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "tool-workspace",
  "description": "Nx plugin providing workspace-wide executors for LLM-optimized reports (lint, typecheck, tests).",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "tags": ["type:util", "scope:internal"],
  "targets": {
    "test": {},
    "typecheck": {},
    "replay-affected": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node --import ./tools/lint/src/runtime/aliases.ts tools/workspace/scripts/replay-affected.ts"
      }
    }
  }
}

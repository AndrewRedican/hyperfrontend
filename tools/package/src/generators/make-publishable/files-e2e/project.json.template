{
  "$schema": "<%= e2eOffsetFromRoot %>node_modules/nx/schemas/project-schema.json",
  "name": "<%= e2eProjectName %>",
  "description": "E2E tests for <%= packageName %> package outputs",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "application",
  "tags": ["type:e2e", "scope:internal"],
  "targets": {
    "e2e": {
      "executor": "@hyperfrontend/package:e2e",
      "dependsOn": ["^build"],
      "options": {
        "formats": ["cjs", "esm", "browser"]
      }
    }
  },
  "implicitDependencies": ["<%= projectName %>"]
}

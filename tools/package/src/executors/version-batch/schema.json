{
  "$schema": "http://json-schema.org/schema",
  "title": "Batch version executor",
  "description": "Run versioning for all affected libraries and create a single batch commit",
  "type": "object",
  "properties": {
    "base": {
      "type": "string",
      "description": "Base git ref for affected detection",
      "default": "origin/main"
    },
    "head": {
      "type": "string",
      "description": "Head git ref for affected detection",
      "default": "HEAD"
    },
    "dryRun": {
      "type": "boolean",
      "description": "Preview changes without making them",
      "default": false
    },
    "scopeFiltering": {
      "type": "object",
      "description": "Commit scope filtering used when attributing commits to a project. Defaults to the version target's declaration.",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["scope-only", "file-only", "hybrid"]
        },
        "excludeScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "includeScopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projectPrefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verbose": {
      "type": "boolean",
      "description": "Enable verbose logging",
      "default": false
    },
    "maxCommitFallback": {
      "type": "number",
      "description": "Upper bound on the commit window the flow analyzes for bumps and changelogs.",
      "default": 500
    }
  },
  "required": []
}

{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "parallel": 1,
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.cjs",
        "{workspaceRoot}/eslint.base.config.cjs",
        "{workspaceRoot}/package.json",
        "{projectRoot}/package.json",
        "{projectRoot}/eslint.config.cjs"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "{projectRoot}/jest.config.ts",
        "passWithNoTests": false,
        "codeCoverage": true
      }
    },
    "@hyperfrontend/package:test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    },
    "version": {
      "executor": "@hyperfrontend/package:version",
      "options": {
        "tagPrefix": "{projectName}@",
        "scopeFiltering": {
          "excludeScopes": ["release", "deps", "workspace", "@hyperfrontend/workspace", "root", "repo", "ci", "build"]
        }
      }
    },
    "version-check": {
      "executor": "@hyperfrontend/package:version-check",
      "options": {
        "scopeFiltering": {
          "excludeScopes": ["release", "deps", "workspace", "@hyperfrontend/workspace", "root", "repo", "ci", "build"]
        }
      }
    },
    "build": {
      "cache": true,
      "inputs": ["default", "^default"],
      "executor": "@hyperfrontend/package:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/{projectRoot}"
      }
    },
    "publish": {
      "dependsOn": ["build"],
      "executor": "@hyperfrontend/package:publish",
      "options": {
        "access": "public",
        "tag": "latest"
      }
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"],
      "executor": "@hyperfrontend/package:typecheck"
    },
    "audit": {
      "cache": true,
      "inputs": ["dependencyState"],
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit --audit-level=high",
        "cwd": "{projectRoot}"
      }
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "dependencyState": [
      "{projectRoot}/package.json",
      "{projectRoot}/package-lock.json",
      "{projectRoot}/.npmrc",
      "{projectRoot}/project.json",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/nx.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.cjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": ["{workspaceRoot}/patches/**"]
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "exclude": ["apps/demos/**/*"]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "exclude": ["**/*-e2e/**/*"]
    }
  ],
  "nxCloudId": "6991685ccc04119366337805",
  "neverConnectToCloud": false,
  "analytics": false
}

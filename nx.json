{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "parallel": 1,
  "tui": {
    "enabled": false
  },
  "targetDefaults": {
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/lint.config.ts",
        "{workspaceRoot}/lint.base.config.ts",
        "{workspaceRoot}/package.json",
        "{projectRoot}/package.json",
        "{projectRoot}/lint.config.ts",
        "{workspaceRoot}/libs/linter/src/**/*",
        "{workspaceRoot}/tools/lint/src/**/*",
        "{workspaceRoot}/tools/lint/config/**/*",
        "{workspaceRoot}/tools/workspace/src/graph/**/*"
      ]
    },
    "@hyperfrontend/package:test": {
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    },
    "version": {
      "executor": "@hyperfrontend/package:version",
      "options": {
        "tagPrefix": "{projectName}@",
        "scopeFiltering": {
          "excludeScopes": ["release", "deps", "workspace", "@hyperfrontend/workspace", "root", "repo", "ci", "build"]
        },
        "maxCommitFallback": 170
      }
    },
    "version-check": {
      "executor": "@hyperfrontend/package:version-check",
      "options": {
        "scopeFiltering": {
          "excludeScopes": ["release", "deps", "workspace", "@hyperfrontend/workspace", "root", "repo", "ci", "build"]
        },
        "maxCommitFallback": 170
      }
    },
    "build": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/assets/media/*/*.json",
        {
          "projects": ["tool-package", "lib-builder"],
          "input": "production"
        }
      ],
      "executor": "@hyperfrontend/package:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/{projectRoot}"
      }
    },
    "publish": {
      "dependsOn": ["build"],
      "executor": "@hyperfrontend/package:publish",
      "options": {
        "access": "public",
        "tag": "latest",
        "provenance": true
      }
    },
    "typecheck": {
      "inputs": ["default", "^production"],
      "executor": "@hyperfrontend/package:typecheck"
    },
    "audit": {
      "inputs": ["dependencyState", { "runtime": "date -u +%F" }],
      "executor": "nx:run-commands",
      "options": {
        "command": "npm audit --audit-level=moderate",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "@hyperfrontend/package:test",
      "options": {}
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "dependencyState": [
      "{projectRoot}/package.json",
      "{projectRoot}/package-lock.json",
      "{projectRoot}/.npmrc",
      "{projectRoot}/project.json",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/nx.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/lint.config.ts",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/test.config.ts",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": ["{workspaceRoot}/patches/**"]
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "plugins": [
    {
      "plugin": "./tools/lint/src/nx/plugin.ts",
      "exclude": ["apps/demos/**/*"]
    }
  ],
  "neverConnectToCloud": true,
  "analytics": false
}

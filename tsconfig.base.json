{
  "compileOnSave": false,
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "sourceMap": false,
    "module": "es2022",
    "moduleResolution": "bundler",
    "importHelpers": false,
    "noEmit": true,
    "isolatedModules": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleDetection": "force",
    "allowJs": true,
    "esModuleInterop": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "webWorker"],
    "types": ["node"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@hyperfrontend/cryptography/browser": ["libs/cryptography/src/browser/index.ts"],
      "@hyperfrontend/cryptography/common": ["libs/cryptography/src/common/index.ts"],
      "@hyperfrontend/cryptography/node": ["libs/cryptography/src/node/index.ts"],
      "@hyperfrontend/data-utils": ["libs/utils/data/src/index.ts"],
      "@hyperfrontend/function-utils": ["libs/utils/function/src/index.ts"],
      "@hyperfrontend/immutable-api-utils": ["libs/utils/immutable-api/src/index.ts"],
      "@hyperfrontend/list-utils": ["libs/utils/list/src/index.ts"],
      "@hyperfrontend/logging": ["libs/logging/src/index.ts"],
      "@hyperfrontend/network-protocol/channel": ["libs/network-protocol/src/channel/index.ts"],
      "@hyperfrontend/network-protocol/data": ["libs/network-protocol/src/data/index.ts"],
      "@hyperfrontend/network-protocol/packet": ["libs/network-protocol/src/packet/index.ts"],
      "@hyperfrontend/network-protocol/v1": ["libs/network-protocol/src/protocol/v1/index.ts"],
      "@hyperfrontend/network-protocol/queue": ["libs/network-protocol/src/queue/index.ts"],
      "@hyperfrontend/network-protocol/receiver": ["libs/network-protocol/src/receiver/index.ts"],
      "@hyperfrontend/network-protocol/routing": ["libs/network-protocol/src/routing/index.ts"],
      "@hyperfrontend/network-protocol/security": ["libs/network-protocol/src/security/index.ts"],
      "@hyperfrontend/network-protocol/sender": ["libs/network-protocol/src/sender/index.ts"],
      "@hyperfrontend/network-protocol/topic": ["libs/network-protocol/src/topic/index.ts"],
      "@hyperfrontend/random-generator-utils": ["libs/utils/random-generator/src/index.ts"],
      "@hyperfrontend/state-machine/actions": ["libs/state-machine/src/actions/index.ts"],
      "@hyperfrontend/state-machine/async-operation": ["libs/state-machine/src/async-operation/index.ts"],
      "@hyperfrontend/state-machine/coordinated-async-operation": ["libs/state-machine/src/coordinated-async-operation/index.ts"],
      "@hyperfrontend/state-machine/events": ["libs/state-machine/src/events/index.ts"],
      "@hyperfrontend/state-machine/lifecyle-aware-component": ["libs/state-machine/src/lifecyle-aware-component/index.ts"],
      "@hyperfrontend/state-machine/models": ["libs/state-machine/src/models/index.ts"],
      "@hyperfrontend/state-machine/reducer": ["libs/state-machine/src/reducer/index.ts"],
      "@hyperfrontend/state-machine/selectors": ["libs/state-machine/src/selectors/index.ts"],
      "@hyperfrontend/state-machine/state": ["libs/state-machine/src/state/index.ts"],
      "@hyperfrontend/state-machine/state-change": ["libs/state-machine/src/state-change/index.ts"],
      "@hyperfrontend/state-machine/store": ["libs/state-machine/src/store/index.ts"],
      "@hyperfrontend/string-utils/browser": ["libs/utils/string/src/browser/index.ts"],
      "@hyperfrontend/string-utils/node": ["libs/utils/string/src/node/index.ts"],
      "@hyperfrontend/time-utils": ["libs/utils/time/src/index.ts"],
      "@hyperfrontend/ui-utils/audio": ["libs/utils/ui/src/audio/index.ts"],
      "@hyperfrontend/ui-utils/color": ["libs/utils/ui/src/color/index.ts"],
      "@hyperfrontend/ui-utils/component": ["libs/utils/ui/src/component/index.ts"],
      "@hyperfrontend/ui-utils/element": ["libs/utils/ui/src/element/index.ts"],
      "@hyperfrontend/ui-utils/event": ["libs/utils/ui/src/event/index.ts"],
      "@hyperfrontend/ui-utils/misc": ["libs/utils/ui/src/misc/index.ts"],
      "@hyperfrontend/ui-utils/mobile": ["libs/utils/ui/src/mobile/index.ts"],
      "@hyperfrontend/ui-utils/selector": ["libs/utils/ui/src/selector/index.ts"],
      "@hyperfrontend/ui-utils/style": ["libs/utils/ui/src/style/index.ts"],
      "@hyperfrontend/ui-utils/time": ["libs/utils/ui/src/time/index.ts"],
      "@hyperfrontend/web-worker": ["libs/web-worker/src/index.ts"],
      "@hyperfrontend/window-messages": ["libs/window-messages/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}

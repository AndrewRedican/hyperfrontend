{
  "compileOnSave": false,
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "rootDir": ".",
    "sourceMap": false,
    "module": "es2022",
    "moduleResolution": "bundler",
    "importHelpers": false,
    "noEmit": true,
    "isolatedModules": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleDetection": "force",
    "allowJs": true,
    "esModuleInterop": true,
    "target": "es2022",
    "lib": ["es2022", "dom", "webWorker"],
    "types": ["node"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@hyperfrontend-cryptography/browser": ["packages/cryptography/src/browser/index.ts"],
      "@hyperfrontend-cryptography/node": ["packages/cryptography/src/node/index.ts"],
      "@hyperfrontend-data-utils": ["packages/data/src/index.ts"],
      "@hyperfrontend-function-utils": ["packages/utils/function/src/index.ts"],
      "@hyperfrontend-immutable-api-utils": ["packages/utils/immutable-api/src/index.ts"],
      "@hyperfrontend-list-utils": ["packages/utils/list/src/index.ts"],
      "@hyperfrontend-logging": ["packages/logging/src/index.ts"],
      "@hyperfrontend-network-protocol/channel": ["packages/network-protocol/src/channel/index.ts"],
      "@hyperfrontend-network-protocol/data": ["packages/network-protocol/src/data/index.ts"],
      "@hyperfrontend-network-protocol/packet": ["packages/network-protocol/src/packet/index.ts"],
      "@hyperfrontend-network-protocol/v1": ["packages/network-protocol/src/protocol/v1/index.ts"],
      "@hyperfrontend-network-protocol/queue": ["packages/network-protocol/src/queue/index.ts"],
      "@hyperfrontend-network-protocol/receiver": ["packages/network-protocol/src/receiver/index.ts"],
      "@hyperfrontend-network-protocol/routing": ["packages/network-protocol/src/routing/index.ts"],
      "@hyperfrontend-network-protocol/security": ["packages/network-protocol/src/security/index.ts"],
      "@hyperfrontend-network-protocol/sender": ["packages/network-protocol/src/sender/index.ts"],
      "@hyperfrontend-network-protocol/topic": ["packages/network-protocol/src/topic/index.ts"],
      "@hyperfrontend-random-generator-utils": ["packages/utils/random-generator/src/index.ts"],
      "@hyperfrontend-state-machine/actions": ["packages/state-machine/src/actions/index.ts"],
      "@hyperfrontend-state-machine/async-operation": ["packages/state-machine/src/async-operation/index.ts"],
      "@hyperfrontend-state-machine/events": ["packages/state-machine/src/events/index.ts"],
      "@hyperfrontend-state-machine/lifecyle-aware-component": ["packages/state-machine/src/lifecyle-aware-component/index.ts"],
      "@hyperfrontend-state-machine/models": ["packages/state-machine/src/models/index.ts"],
      "@hyperfrontend-state-machine/reducer": ["packages/state-machine/src/reducer/index.ts"],
      "@hyperfrontend-state-machine/selectors": ["packages/state-machine/src/selectors/index.ts"],
      "@hyperfrontend-state-machine/state": ["packages/state-machine/src/state/index.ts"],
      "@hyperfrontend-state-machine/state-change": ["packages/state-machine/src/state-change/index.ts"],
      "@hyperfrontend-state-machine/store": ["packages/state-machine/src/store/index.ts"],
      "@hyperfrontend-string-utils/browser": ["packages/utils/string/src/browser/index.ts"],
      "@hyperfrontend-string-utils/node": ["packages/utils/string/src/node/index.ts"],
      "@hyperfrontend-time-utils": ["packages/utils/time/src/index.ts"],
      "@hyperfrontend-ui-utils/audio": ["packages/utils/ui/src/adui/index.ts"],
      "@hyperfrontend-ui-utils/color": ["packages/utils/ui/color/index.ts"],
      "@hyperfrontend-ui-utils/component": ["packages/utils/ui/component/index.ts"],
      "@hyperfrontend-ui-utils/element": ["packages/utils/ui/element/index.ts"],
      "@hyperfrontend-ui-utils/event": ["packages/utils/ui/event/index.ts"],
      "@hyperfrontend-ui-utils/misc": ["packages/utils/ui/misc/index.ts"],
      "@hyperfrontend-ui-utils/mobile": ["packages/utils/ui/mobile/index.ts"],
      "@hyperfrontend-ui-utils/selector": ["packages/utils/ui/selector/index.ts"],
      "@hyperfrontend-ui-utils/style": ["packages/utils/ui/style/index.ts"],
      "@hyperfrontend-ui-utils/time": ["packages/utils/ui/time/index.ts"],
      "@hyperfrontend-web-worker": ["packages/web-worker/src/index.ts"],
      "@hyperfrontend-window-messages": ["packages/window-messages/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}

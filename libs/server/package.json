{
  "name": "@hyperfrontend/server",
  "version": "0.2.0",
  "description": "A small HTTP kernel for Node.js: a service is a list of steps that return responses, run as a process with fixed exit codes, one started line and a graceful stop.",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hyperfrontend/immutable-api-utils": "1.0.6",
    "@hyperfrontend/project-scope": "0.6.1"
  },
  "exports": {
    ".": "./src/index.js",
    "./environment": "./src/environment/index.js",
    "./manifest": "./src/manifest/index.js",
    "./policy": "./src/policy/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "sideEffects": false,
  "keywords": [
    "http",
    "http-server",
    "router",
    "middleware",
    "service",
    "streaming",
    "health-check",
    "readiness",
    "cors",
    "static-server",
    "static-files",
    "nodejs",
    "compression",
    "brotli",
    "gzip",
    "etag",
    "conditional-requests",
    "response-headers",
    "cross-origin-isolation",
    "pipeline",
    "graceful-shutdown",
    "exit-codes",
    "environment-variables",
    "configuration",
    "release-manifest",
    "sha256",
    "zero-dependencies",
    "typescript",
    "hyperfrontend"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/AndrewRedican"
  }
}

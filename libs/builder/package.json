{
  "name": "@hyperfrontend/builder",
  "version": "0.0.1",
  "description": "Composable, vendor-neutral build toolkit for TypeScript libraries, JS bins, and Node SEA native binaries.",
  "license": "MIT",
  "dependencies": {
    "@hyperfrontend/logging": "0.2.0",
    "@hyperfrontend/immutable-api-utils": "0.1.2",
    "@hyperfrontend/project-scope": "0.2.1",
    "@hyperfrontend/versioning": "0.6.0",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.3.0",
    "postject": "1.0.0-alpha.6",
    "rollup": "4.59.0",
    "rollup-plugin-dts": "6.4.1",
    "typescript": "5.9.3"
  },
  "exports": {
    ".": "./src/index.js",
    "./bin": "./src/bin/index.js",
    "./bin/native": "./src/bin/native/index.js",
    "./bin/native/worker": "./src/bin/native/worker/index.js",
    "./bin/script": "./src/bin/script/index.js",
    "./bundle": "./src/bundle/index.js",
    "./bundle/declarations": "./src/bundle/declarations/index.js",
    "./bundle/dedupe": "./src/bundle/dedupe/index.js",
    "./bundle/dependencies": "./src/bundle/dependencies/index.js",
    "./bundle/dependencies/worker": "./src/bundle/dependencies/worker/index.js",
    "./bundle/entries": "./src/bundle/entries/index.js",
    "./bundle/externals": "./src/bundle/externals/index.js",
    "./bundle/rollup": "./src/bundle/rollup/index.js",
    "./bundle/rollup/worker": "./src/bundle/rollup/worker/index.js",
    "./memory": "./src/memory/index.js",
    "./models": "./src/models/index.js",
    "./package": "./src/package/index.js",
    "./package/assets": "./src/package/assets/index.js",
    "./package/json": "./src/package/json/index.js",
    "./package/licenses": "./src/package/licenses/index.js",
    "./presets": "./src/presets/index.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "builder",
    "hyperfrontend",
    "typescript",
    "isomorphic"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/AndrewRedican"
  }
}

{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "lib-builder",
  "description": "Composable, vendor-neutral build toolkit for TypeScript libraries, JS bins, and Node SEA native binaries.",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "tags": ["type:util", "scope:public"],
  "metadata": {
    "compatibility": {
      "environments": {
        "node": "full",
        "browser": "none",
        "webWorker": "none"
      },
      "note": "Node.js 18 needs `--experimental-global-webcrypto` only to import `/bundle/rollup/worker` directly; `hf-build` passes it to the worker it spawns."
    }
  },
  "targets": {
    "version": {},
    "version-check": {},
    "build": {
      "executor": "@hyperfrontend/package:build",
      "options": {
        "esm": {
          "bundleWorkspaceDeps": true,
          "bundleAllDeps": { "exclude": ["tslib"] }
        },
        "cjs": {
          "bundleWorkspaceDeps": true,
          "bundleAllDeps": { "exclude": ["tslib"] }
        },
        "bin": [
          {
            "name": "hf-build",
            "format": ["cjs"],
            "sea": {
              "platforms": ["linux-x64", "linux-arm64", "darwin-x64", "darwin-arm64", "win32-x64"]
            }
          }
        ]
      }
    },
    "publish": {},
    "typecheck": {},
    "test": {}
  }
}

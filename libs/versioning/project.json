{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "lib-versioning",
  "description": "Versioning library with changelog parsing, conventional commits, and semver flow orchestration.",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "tags": ["type:util", "scope:public"],
  "metadata": {
    "compatibility": {
      "environments": {
        "node": "full",
        "browser": "none",
        "webWorker": "none"
      }
    }
  },
  "targets": {
    "version": {},
    "version-check": {},
    "build": {
      "executor": "@hyperfrontend/package:build",
      "options": {
        "esm": { "bundleWorkspaceDeps": true, "bundleAllDeps": true },
        "cjs": { "bundleWorkspaceDeps": true, "bundleAllDeps": true },
        "bin": [
          { "name": "cz", "runner": "runCz", "format": "cjs" },
          { "name": "cl", "runner": "runCl", "format": "cjs" }
        ]
      }
    },
    "publish": {},
    "typecheck": {},
    "test": {}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Message",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "description": "Arbitrary message payload"
    },
    "timestamp": {
      "type": "number"
    }
  },
  "additionalProperties": true
}

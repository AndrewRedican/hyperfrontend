{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Action",
  "type": "object",
  "required": ["type", "senderId"],
  "properties": {
    "type": {
      "type": "string"
    },
    "senderId": {
      "type": "string"
    },
    "processId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "contract": {
      "type": "object"
    },
    "error": {
      "type": "string"
    },
    "data": {}
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Contract",
  "type": "object",
  "required": ["accepted", "emitted"],
  "properties": {
    "accepted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" },
          "schema": { "type": "object" }
        }
      }
    },
    "emitted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "description": { "type": "string" },
          "schema": { "type": "object" }
        }
      }
    }
  }
}

{
  "name": "@hyperfrontend/testing",
  "version": "0.1.0",
  "description": "A lightweight Jest-like testing library built on native Node capabilities.",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=8.0.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./coverage": "./src/coverage/index.js",
    "./dom": "./src/dom/index.js",
    "./hooks": "./src/hooks/index.js",
    "./reporter": "./src/reporter/index.js",
    "./runner": "./src/runner/index.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "jsdom": ">=26.0.0"
  },
  "peerDependenciesMeta": {
    "jsdom": {
      "optional": true
    }
  },
  "keywords": [
    "testing",
    "test-runner",
    "node-test",
    "nodejs",
    "unit-testing",
    "assertions",
    "expect",
    "matchers",
    "jest",

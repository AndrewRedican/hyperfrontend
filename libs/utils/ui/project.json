{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "lib-ui-utils",
  "description": "UI utilities for elements, events, styling, and mobile interactions.",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "tags": ["type:util", "scope:public"],
  "metadata": {
    "compatibility": {
      "environments": {
        "node": "partial",
        "browser": "full",
        "webWorker": "full"
      },
      "note": "Some utilities require browser APIs; check individual exports."
    }
  },
  "targets": {
    "version": {},
    "version-check": {},
    "build": {
      "executor": "@hyperfrontend/package:build",
      "options": {
        "esm": { "bundleWorkspaceDeps": true, "bundleAllDeps": true },
        "cjs": { "bundleWorkspaceDeps": true, "bundleAllDeps": true },
        "iife": {
          "entry": ".",
          "globalName": "HyperfrontendUIUtils"
        },
        "umd": {
          "entry": ".",
          "globalName": "HyperfrontendUIUtils"
        }
      }
    },
    "publish": {},
    "typecheck": {},
    "test": {}
  }
}

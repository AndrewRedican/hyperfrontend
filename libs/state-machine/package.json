{
  "name": "@hyperfrontend/state-machine",
  "version": "0.0.4",
  "description": "Lightweight, functional state management library with Redux-inspired actions/reducers, async operation orchestration, and lifecycle-aware component abstractions for predictable application state.",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "state-management",
    "redux",
    "flux",
    "store",
    "actions",
    "reducers",
    "async-operations",
    "lifecycle",
    "event-driven",
    "functional",
    "typescript",
    "zero-dependencies",
    "tree-shakeable",
    "immutable",
    "process-state"
  ],
  "exports": {
    ".": "./src/index.js",
    "./actions": "./src/actions/index.js",
    "./async-operation": "./src/async-operation/index.js",
    "./coordinated-async-operation": "./src/coordinated-async-operation/index.js",
    "./events": "./src/events/index.js",
    "./lifecycle-aware-component": "./src/lifecycle-aware-component/index.js",
    "./models": "./src/models/index.js",
    "./reducer": "./src/reducer/index.js",
    "./selectors": "./src/selectors/index.js",
    "./state": "./src/state/index.js",
    "./state-change": "./src/state-change/index.js",
    "./store": "./src/store/index.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@hyperfrontend/data-utils": "0.0.4",
    "@hyperfrontend/immutable-api-utils": "0.1.0"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/AndrewRedican"
  }
}

{
  "name": "library-with-exports",
  "version": "1.0.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "browser": "dist/browser.js",
  "bin": {
    "lib-cli": "bin/cli.js",
    "lib-tool": "bin/tool.js"
  },
  "exports": {

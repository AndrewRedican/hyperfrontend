{
  "name": "@hyperfrontend/network-protocol",
  "version": "0.0.4",
  "description": "Production-grade network protocol for secure, real-time cross-window and cross-process communication with built-in encryption, obfuscation, routing, and message queueing.",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "network-protocol",
    "secure-messaging",
    "cross-window-communication",
    "postmessage",
    "ipc",
    "encryption",
    "obfuscation",
    "message-queue",
    "pub-sub",
    "routing",
    "isomorphic",
    "browser",
    "nodejs",
    "micro-frontend",
    "web-worker",
    "typescript"
  ],
  "exports": {
    "./browser/channel": "./src/browser/channel/index.js",
    "./node/channel": "./src/node/channel/index.js",
    "./queue": "./src/lib/queue/index.js",
    "./routing": "./src/lib/routing/index.js",
    "./security": "./src/lib/security/index.js",
    "./topic": "./src/lib/topic/index.js",
    "./browser/data": "./src/browser/data/index.js",
    "./node/data": "./src/node/data/index.js",
    "./browser/packet": "./src/browser/packet/index.js",
    "./node/packet": "./src/node/packet/index.js",
    "./browser/v1": "./src/browser/v1/index.js",
    "./node/v1": "./src/node/v1/index.js",
    "./browser/v2": "./src/browser/v2/index.js",
    "./node/v2": "./src/node/v2/index.js",
    "./browser/sender": "./src/browser/sender/index.js",
    "./node/sender": "./src/node/sender/index.js",
    "./browser/receiver": "./src/browser/receiver/index.js",
    "./node/receiver": "./src/node/receiver/index.js"
  },
  "dependencies": {
    "@hyperfrontend/cryptography": "0.0.2",
    "@hyperfrontend/data-utils": "0.0.2",
    "@hyperfrontend/json-utils": "0.0.2",
    "@hyperfrontend/list-utils": "0.0.2",
    "@hyperfrontend/logging": "0.0.2",
    "@hyperfrontend/random-generator-utils": "0.0.2",
    "@hyperfrontend/string-utils": "0.0.2",
    "@hyperfrontend/time-utils": "0.0.2",
    "@hyperfrontend/immutable-api-utils": "0.0.2"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/AndrewRedican"
  }
}

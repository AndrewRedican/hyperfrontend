{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "lib-network-protocol",
  "description": "Network protocol implementation with channels, routing, and security.",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "tags": ["type:protocol", "scope:public"],
  "targets": {
    "version": {},
    "build": {
      "executor": "@hyperfrontend/package:build",
      "options": {
        "esm": { "bundleWorkspaceDeps": true },
        "cjs": { "bundleWorkspaceDeps": true },
        "iife": [
          {
            "entry": "./browser/v1",
            "globalName": "HyperfrontendNetworkProtocolV1",
            "output": "bundle/v1"
          },
          {
            "entry": "./browser/v2",
            "globalName": "HyperfrontendNetworkProtocolV2",
            "output": "bundle/v2"
          }
        ],
        "umd": [
          {
            "entry": "./browser/v1",
            "globalName": "HyperfrontendNetworkProtocolV1",
            "output": "bundle/v1"
          },
          {
            "entry": "./browser/v2",
            "globalName": "HyperfrontendNetworkProtocolV2",
            "output": "bundle/v2"
          }
        ]
      }
    },
    "publish": {},
    "typecheck": {}
  }
}

import type { TestConfig } from '@hyperfrontend/testing/runner'

/**
 * How the `<%= projectName %>` service is tested.
 */
const config: TestConfig = {
  environments: [{ name: 'node', testMatch: ['src/**/*.spec.ts'] }],
  coverageInclude: ['src/**/*.ts'],
  // why: src/main.ts only hands the service to the runner, which takes over the process that loads it; src/service.spec.ts drives the same service through the runner with a stand-in for the process
  coverageExclude: ['src/main.ts'],
  coverageThresholds: { lines: 100, branches: 100, functions: 100 },
}

export default config

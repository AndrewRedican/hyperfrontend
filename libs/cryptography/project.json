{
  "name": "lib-cryptography",
  "description": "Cryptography utilities for browser and Node.js environments.",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "tags": ["type:util", "scope:public"],
  "metadata": {
    "compatibility": {
      "environments": {
        "node": "full",
        "browser": "full",
        "webWorker": "full"
      },
      "note": "`/browser` reads `globalThis.crypto` at first use; on Node.js that needs 19+ or 18 with `--experimental-global-webcrypto`."
    }
  },
  "targets": {
    "version": {},
    "version-check": {},
    "build": {
      "executor": "@hyperfrontend/package:build",
      "options": {
        "esm": { "bundleWorkspaceDeps": true, "bundleAllDeps": true },
        "cjs": { "bundleWorkspaceDeps": true, "bundleAllDeps": true },
        "iife": {
          "entry": "./browser",
          "globalName": "HyperfrontendCryptography"
        },
        "umd": {
          "entry": "./browser",
          "globalName": "HyperfrontendCryptography"
        }
      }
    },
    "publish": {},
    "typecheck": {},
    "test": {}
  }
}

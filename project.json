{
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "name": "@hyperfrontend/workspace",
  "description": "A hybrid micro-frontend pattern to embed live web applications with communication protocols, lifecycle, and contract standards.",
  "tags": [],
  "targets": {
    "lint": {
      "inputs": [
        "{workspaceRoot}/.github/workflows/**/*",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/ARCHITECTURE.md",
        "{workspaceRoot}/LIBRARY_COMPATIBILITY.md",
        "{workspaceRoot}/tsconfig.base.json",
        "{workspaceRoot}/lint.config.ts",
        "{workspaceRoot}/lint.base.config.ts",
        "{workspaceRoot}/tools/lint/src/**/*",
        "{workspaceRoot}/tools/lint/config/**/*",
        "{workspaceRoot}/libs/**/project.json",
        "{workspaceRoot}/plugins/**/project.json",
        "{workspaceRoot}/apps/**/project.json",
        "{workspaceRoot}/apps/**/package.json",
        "{workspaceRoot}/apps/package-e2e/shared/**/*",
        "{workspaceRoot}/.devcontainer/devcontainer.json"
      ],
      "command": "node tools/lint/bin/lint.ts --max-warnings 0 --no-error-on-unmatched-pattern '.github/workflows' 'package.json' 'README.md' 'ARCHITECTURE.md' 'LIBRARY_COMPATIBILITY.md' 'tsconfig.base.json' 'apps/*/project.json' 'apps/*/*/project.json' 'apps/*/*/*/project.json' 'apps/*/package.json' 'apps/*/*/package.json' 'apps/*/*/*/package.json' 'apps/package-e2e/shared'"
    },
    "version:all": {
      "executor": "@hyperfrontend/package:version-batch",
      "options": {
        "base": "origin/main",
        "head": "HEAD"
      }
    },
    "lint:all": {
      "executor": "@hyperfrontend/workspace:lint-report",
      "options": {
        "outputPath": "lint-output.txt",
        "affected": false,
        "maxFixes": 5,
        "failOnError": true
      }
    },
    "audit": {}
  }
}

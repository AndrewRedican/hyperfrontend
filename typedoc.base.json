{
  "$schema": "https://typedoc.org/schema.json",
  "entryPointStrategy": "expand",
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "excludeNotDocumented": false,
  "includeVersion": true,
  "readme": "none",
  "json": "./api.json",
  "pretty": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true
  }
}

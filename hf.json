{
  "targetDefaults": {
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/lint.config.ts",
        "{workspaceRoot}/lint.base.config.ts",
        "{workspaceRoot}/package.json",
        "{projectRoot}/package.json",
        "{projectRoot}/lint.config.ts",
        {
          "projects": ["lib-linter", "tool-lint"],
          "input": "lintTooling"
        },
        {
          "projects": "lib-workspace",
          "input": "lintRules"
        },
        {
          "projects": "lib-workspace",
          "input": "engine"
        }
      ]
    },
    "version": {
      "executor": "@hyperfrontend/package:version",
      "options": {
        "tagPrefix": "{projectName}@",
        "scopeFiltering": {
          "excludeScopes": ["release", "deps", "workspace", "hyperfrontend", "@hyperfrontend/workspace", "root", "repo", "ci", "build"]
        },
        "maxCommitFallback": 10000
      }
    },
    "version-check": {
      "inputs": [
        "{projectRoot}/**/*",
        "^production",
        {
          "projects": "tool-package",
          "input": "buildExecutor"
        },
        {
          "projects": "lib-builder",
          "input": "toolchain"
        },
        {
          "projects": "lib-workspace",
          "input": "buildExecutor"
        },
        {
          "projects": "lib-workspace",
          "input": "versionFlow"
        }
      ],
      "executor": "@hyperfrontend/workspace:version-check",
      "options": {
        "scopeFiltering": {
          "excludeScopes": ["release", "deps", "workspace", "hyperfrontend", "@hyperfrontend/workspace", "root", "repo", "ci", "build"]
        },
        "maxCommitFallback": 10000
      }
    },
    "build": {
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/assets/media/*/*.json",
        {
          "projects": "tool-package",
          "input": "buildExecutor"
        },
        {
          "projects": "lib-builder",
          "input": "toolchain"
        },
        {
          "projects": "lib-workspace",
          "input": "buildExecutor"
        },
        {
          "projects": "lib-workspace",
          "input": "engine"
        }
      ],
      "executor": "@hyperfrontend/package:build",
      "options": {
        "outputPath": "dist/{projectRoot}",
        "rootAssets": ["LICENSE.md", "SECURITY.md", "FUNDING.md"]
      }
    },
    "publish": {
      "dependsOn": ["build"],
      "executor": "@hyperfrontend/workspace:publish",
      "options": {
        "access": "public",
        "tag": "latest",
        "provenance": true
      }
    },
    "typecheck": {
      "inputs": [
        "code",
        "^production",
        {
          "projects": "lib-workspace",
          "input": "typecheckExecutor"
        },
        {
          "projects": "lib-workspace",
          "input": "engine"
        }
      ],
      "executor": "@hyperfrontend/workspace:typecheck"
    },
    "audit": {
      "inputs": ["dependencyState"],
      "executor": "@hyperfrontend/workspace:run-commands",
      "options": {
        "command": "npm audit --audit-level=moderate",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        {
          "projects": "lib-workspace",
          "input": "testExecutor"
        },
        {
          "projects": "lib-workspace",
          "input": "engine"
        }
      ],
      "executor": "@hyperfrontend/workspace:test",
      "options": {}
    },
    "e2e": {
      "inputs": [
        "default",
        "^default",
        {
          "projects": "lib-workspace",
          "input": "e2eExecutor"
        },
        {
          "projects": "lib-workspace",
          "input": "engine"
        }
      ]
    },
    "install": {
      "inputs": [
        "default",
        "^default",
        {
          "projects": "lib-workspace",
          "input": "engine"
        }
      ]
    }
  },
  "namedInputs": {
    "buildExecutor": ["executorCore", "{projectRoot}/src/executors/build/**/*"],
    "versionFlow": [
      "executorCore",
      "{projectRoot}/src/graph/**/*",
      "{projectRoot}/src/executors/version/**/*",
      "{projectRoot}/src/executors/version-batch/**/*",
      "{projectRoot}/src/executors/version-check/**/*"
    ],
    "lintTooling": ["{projectRoot}/bin/**/*", "{projectRoot}/config/**/*", "{projectRoot}/src/**/*", "noTestMaterial"],
    "lintRules": ["{projectRoot}/src/graph/**/*", "{projectRoot}/src/lint/**/*", "noTestMaterial"],
    "typecheckExecutor": ["executorCore", "{projectRoot}/src/executors/typecheck/**/*"],
    "testExecutor": ["executorCore", "{projectRoot}/src/executors/test/**/*"],
    "e2eExecutor": ["executorCore", "{projectRoot}/src/executors/e2e/**/*", "{projectRoot}/src/hooks/**/*"],
    "toolchain": [
      "{projectRoot}/package.json",
      "{projectRoot}/src/models/**/*",
      "{projectRoot}/src/presets/**/*",
      "{projectRoot}/src/bundle/entries/**/*",
      "{projectRoot}/src/bundle/externals/**/*",
      "{projectRoot}/src/bundle/dependencies/**/*",
      "{projectRoot}/src/bundle/dedupe/**/*",
      "{projectRoot}/src/bundle/rollup/**/*",
      "{projectRoot}/src/bundle/declarations/**/*",
      "!{projectRoot}/src/bundle/declarations/resolve-tsc-script.ts",
      "{projectRoot}/src/bundle/strip-bundle-comments.ts",
      "{projectRoot}/src/package/**/*",
      "{projectRoot}/src/bin/**/*",
      "!{projectRoot}/**/README.md",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "dependencyState": [
      "{projectRoot}/package.json",
      "{projectRoot}/package-lock.json",
      "{projectRoot}/.npmrc",
      "{projectRoot}/project.json",
      "{workspaceRoot}/.npmrc",
      "{workspaceRoot}/hf.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/lint.config.ts",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/test.config.ts",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": ["{workspaceRoot}/patches/**"],
    "noTestMaterial": [
      "!{projectRoot}/**/__test-utils__/**",
      "!{projectRoot}/**/README.md",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)"
    ],
    "code": ["default", "!{projectRoot}/**/*.md"],
    "engine": ["{projectRoot}/src/runner/**/*", "{projectRoot}/src/hooks/**/*", "{projectRoot}/src/cli/**/*", "noTestMaterial"],
    "executorCore": ["{projectRoot}/src/graph/json.ts", "{projectRoot}/src/executors/shared/**/*", "noTestMaterial"]
  },
  "lint": {
    "command": "node {workspaceRoot}/tools/lint/bin/lint.ts .",
    "exclude": ["apps/demos/**/*"]
  }
}

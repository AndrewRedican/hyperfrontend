    "build:watch": "vite build --watch",
    "hf:dev": "hf dev",
    "dev:hosted": "run-p build:watch hf:dev"
  },
  "dependencies": {
    "@hyperfrontend/features": "0.7.1",
    "@hyperfrontend/random-generator-utils": "0.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "npm-run-all2": "9.0.3",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }

{
  "name": "@hyperfrontend/demo-heartbeat",
  "version": "0.2.0",
  "description": "Heartbeat demonstration — an anatomical heart feature (React) observed by a vanilla-TS ECG host, contrasting app-level cardiac events with the SDK's liveness watchdog.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "build:watch": "vite build --watch",
    "hf:dev": "hf dev",
    "dev:hosted": "run-p build:watch hf:dev"
  },
  "dependencies": {
    "@hyperfrontend/features": "0.5.1",
    "@hyperfrontend/random-generator-utils": "0.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.8.1",
    "eslint-plugin-oxlint": "1.78.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "16.5.0",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.78.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}

{
  "name": "@hyperfrontend/demo-clock",
  "version": "0.3.0",
  "description": "Clock demonstration — a spinnable clock coin built as a hyperfrontend feature.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "build:watch": "vite build --watch",
    "hf:dev": "hf dev",
    "dev:hosted": "run-p build:watch hf:dev"
  },
  "dependencies": {
    "@hyperfrontend/features": "0.7.1",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "axe-core": "4.13.0",
    "eslint": "10.8.1",
    "eslint-plugin-oxlint": "1.78.0",
    "eslint-plugin-vue": "10.10.0",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.78.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.10"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}

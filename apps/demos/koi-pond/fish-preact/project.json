{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "demo-koi-fish-preact",
  "description": "Koi pond — the Preact koi, a standalone hostee feature rendering one fish inside a host-owned transparent full-viewport frame.",
  "sourceRoot": "apps/demos/koi-pond/fish-preact/src",
  "projectType": "application",
  "tags": ["type:demo", "role:feature", "scope:standalone"],
  "targets": {
    "install": {
      "executor": "@hyperfrontend/app:install",
      "options": {}
    },
    "dev": {
      "executor": "@hyperfrontend/app:serve",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run build:watch"
      }
    },
    "build": {
      "executor": "@hyperfrontend/app:build",
      "dependsOn": ["install"],
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/apps/demos/koi-pond/site/fish-preact"],
      "options": {
        "command": "npm run build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run test:unit -- --run",
        "cwd": "apps/demos/koi-pond/fish-preact"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run lint",
        "cwd": "apps/demos/koi-pond/fish-preact"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run type-check",
        "cwd": "apps/demos/koi-pond/fish-preact"
      }
    }
  }
}

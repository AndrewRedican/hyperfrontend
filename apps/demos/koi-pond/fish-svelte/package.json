{
  "name": "@hyperfrontend/demo-koi-fish-svelte",
  "version": "0.1.0",
  "description": "Koi pond — the Svelte koi, a standalone hostee feature rendering one procedurally animated fish.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "run-s \"type-check:*\"",
    "type-check:app": "svelte-check --tsconfig ./tsconfig.app.json",
    "type-check:node": "tsc --build tsconfig.node.json",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "build:watch": "vite build --watch"
  },
  "dependencies": {
    "@hyperfrontend/demo-koi-lib": "file:../vendor/hyperfrontend-demo-koi-lib-0.1.0.tgz",
    "@hyperfrontend/features": "0.7.0",
    "svelte": "5.56.9",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.13.3",
    "@types/three": "0.185.4",
    "eslint": "10.8.1",
    "eslint-plugin-oxlint": "1.78.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "jiti": "2.7.0",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.78.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}

{
  "include": ["env.d.ts", "src/**/*", "../lib/src/**/*"],
  "exclude": ["src/**/__tests__/*", "../lib/src/**/__tests__/*"],
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    // Extra safety for array and object lookups, but may have false positives.
    "noUncheckedIndexedAccess": true,

    // Path mapping for cleaner imports.
    "paths": {
      "@/*": ["./src/*"],

      // why: The workbench compiles the koi lib from source rather than from its packed tarball, so a geometry edit type-checks and hot-reloads without a repack.
      "@hyperfrontend/demo-koi-lib": ["../lib/src/index.ts"],
      "@hyperfrontend/demo-koi-lib/three": ["../lib/src/three/index.ts"]
    },

    // `tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}

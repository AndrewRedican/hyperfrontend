{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "demo-koi-lib",
  "description": "Shared koi model, contract, and geometry consumed by the pond host and the seven fish apps as a packed tarball.",
  "sourceRoot": "apps/demos/koi-pond/lib/src",
  "projectType": "library",
  "tags": ["type:demo", "role:shared", "scope:standalone"],
  "metadata": {
    "lifecycle": {
      "state": "frozen",
      "since": "2026-08-25",
      "reason": "Shipped demonstration. Its behaviour is the exhibit the docs site embeds and the guides extract from; process added here is maintenance cost that buys nothing."
    }
  },
  "targets": {
    "install": {
      "executor": "@hyperfrontend/app:install",
      "options": {}
    },
    "build": {
      "executor": "@hyperfrontend/app:build",
      "dependsOn": ["install"],
      "cache": false,
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "npm run build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run type-check",
        "cwd": "apps/demos/koi-pond/lib"
      }
    },
    "refresh": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "cache": false,
      "options": {
        "command": "node ../tools/refresh-lib.mjs",
        "cwd": "apps/demos/koi-pond/lib"
      }
    },
    "verify": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "cache": false,
      "options": {
        "command": "node ../tools/refresh-lib.mjs --check",
        "cwd": "apps/demos/koi-pond/lib"
      }
    },
    "audit": {}
  }
}

{
  "name": "@hyperfrontend/demo-koi-lib",
  "version": "0.1.0",
  "description": "Shared koi model, contract, and geometry for the koi pond demonstration.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js"
    },
    "./fish.css": "./dist/styles/fish.css"
  },
  "scripts": {
    "build": "run-s \"build:*\"",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:styles": "mkdir -p dist/styles && cp src/styles/fish.css dist/styles/fish.css",
    "type-check": "run-s \"type-check:*\"",
    "type-check:src": "tsc -p tsconfig.spec.json",
    "type-check:node": "tsc -p tsconfig.node.json",
    "test:unit": "vitest",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache"
  },
  "dependencies": {
    "@hyperfrontend/random-generator-utils": "0.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.3",
    "@types/three": "0.185.4",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.8.1",
    "eslint-plugin-oxlint": "1.78.0",
    "globals": "17.11.0",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.78.0",
    "three": "0.185.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "peerDependencies": {
    "three": "^0.185.1"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}

// TSConfig that type-checks everything including the specs, without emitting.
{
  "extends": "./tsconfig.build.json",
  "include": ["src/**/*.ts"],
  "exclude": [],
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.spec.tsbuildinfo"
  }
}

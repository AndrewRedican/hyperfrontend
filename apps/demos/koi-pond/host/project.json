{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "demo-koi-pond",
  "description": "Koi pond demonstration — a vanilla-TS host compositing seven independently implemented koi features into one continuous scene, and itself a hostee for the docs-site gallery.",
  "sourceRoot": "apps/demos/koi-pond/host/src",
  "projectType": "application",
  "tags": ["type:demo", "role:feature", "scope:standalone"],
  "metadata": {
    "deploy": {
      "provider": "railway",
      "service": "hyperfrontend-demo-koi-pond",
      "origin": "https://demo-koi-pond-production.up.railway.app",
      "boundary": "same-origin",
      "kind": "static",
      "publishDir": "dist/apps/demos/koi-pond/site"
    }
  },
  "targets": {
    "install": {
      "executor": "@hyperfrontend/app:install",
      "options": {}
    },
    "dev": {
      "executor": "@hyperfrontend/app:serve",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run dev"
      }
    },
    "dev-hosted": {
      "executor": "@hyperfrontend/app:serve",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run dev:hosted"
      }
    },
    "build": {
      "executor": "@hyperfrontend/app:build",
      "dependsOn": ["install", "demo-koi-lib:verify"],
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/apps/demos/koi-pond/site"],
      "options": {
        "command": "npm run build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run test:unit -- --run",
        "cwd": "apps/demos/koi-pond/host"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run lint",
        "cwd": "apps/demos/koi-pond/host"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run type-check",
        "cwd": "apps/demos/koi-pond/host"
      }
    },
    "pack-shell": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "outputs": ["{workspaceRoot}/dist/apps/demos/koi-pond/shell"],
      "options": {
        "command": "npx hf build --ci --out ../../../../dist/apps/demos/koi-pond/shell",
        "cwd": "apps/demos/koi-pond/host"
      }
    }
  }
}

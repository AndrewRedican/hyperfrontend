{
  "trailingSlash": true,
  "directoryListing": false,
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://www.hyperfrontend.dev https://hyperfrontend.dev https://*.vercel.app"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "fish-*/**",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://demo-koi-pond-production.up.railway.app https://www.hyperfrontend.dev https://hyperfrontend.dev https://*.vercel.app"
        }
      ]
    }
  ]
}

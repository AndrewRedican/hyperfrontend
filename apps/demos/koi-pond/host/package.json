    "@hyperfrontend/demo-koi-fish-react-shell": "file:vendor/hyperfrontend-demo-koi-fish-react-shell-0.2.0.tgz",
    "@hyperfrontend/demo-koi-fish-solid-shell": "file:vendor/hyperfrontend-demo-koi-fish-solid-shell-0.2.0.tgz",
    "@hyperfrontend/demo-koi-fish-svelte-shell": "file:vendor/hyperfrontend-demo-koi-fish-svelte-shell-0.2.0.tgz",
    "@hyperfrontend/demo-koi-fish-vanilla-shell": "file:vendor/hyperfrontend-demo-koi-fish-vanilla-shell-0.2.0.tgz",
    "@hyperfrontend/demo-koi-fish-vue-shell": "file:vendor/hyperfrontend-demo-koi-fish-vue-shell-0.2.0.tgz",
    "@hyperfrontend/demo-koi-lib": "file:../vendor/hyperfrontend-demo-koi-lib-0.1.0.tgz",
    "@hyperfrontend/features": "^0.5.1",
    "@hyperfrontend/random-generator-utils": "^0.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.2",
    "@vitest/eslint-plugin": "^1.6.20",
    "eslint": "^10.5.0",
    "eslint-plugin-oxlint": "~1.76.0",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.76.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }

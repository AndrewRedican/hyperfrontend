{
  "name": "@hyperfrontend/demo-koi-pond",
  "version": "0.1.0",
  "description": "Koi pond demonstration — a host-owned zen pond compositing seven independently implemented koi into one continuous scene.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "build:watch": "vite build --watch",
    "hf:dev": "hf dev --port 4290",
    "dev:hosted": "run-p build:watch hf:dev"
  },
  "dependencies": {
    "@hyperfrontend/demo-koi-fish-lit-shell": "file:vendor/hyperfrontend-demo-koi-fish-lit-shell-0.2.0.tgz",

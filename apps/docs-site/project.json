{
  "name": "docs-site",
  "description": "Next.js documentation site for hyperfrontend.",
  "sourceRoot": "apps/docs-site/src",
  "projectType": "application",
  "tags": ["type:app", "scope:standalone"],
  "implicitDependencies": ["demo-clock", "demo-heartbeat", "demo-koi-pond"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "apps/docs-site"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run test",
        "cwd": "apps/docs-site"
      }
    },
    "install": {
      "executor": "@hyperfrontend/app:install",
      "options": {}
    },
    "refresh-shell": {
      "executor": "nx:run-commands",
      "dependsOn": ["demo-clock:pack-shell", "demo-heartbeat:pack-shell", "demo-koi-pond:pack-shell"],
      "options": {
        "commands": [
          "cp ../../dist/apps/demos/clock/shell/hyperfrontend-demo-clock-shell-*.tgz vendor/",
          "cp ../../dist/apps/demos/heartbeat/shell/hyperfrontend-demo-heartbeat-shell-*.tgz vendor/",
          "cp ../../dist/apps/demos/koi-pond/shell/hyperfrontend-demo-koi-pond-shell-*.tgz vendor/",
          "node ./scripts/install-vendored-shells.mjs"
        ],
        "cwd": "apps/docs-site",
        "parallel": false
      }
    },
    "refresh-downloads": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run refresh-downloads --",
        "cwd": "apps/docs-site"
      }
    },
    "build": {
      "executor": "@hyperfrontend/app:build",
      "dependsOn": ["install"],
      "inputs": [
        "default",
        "{workspaceRoot}/ACKNOWLEDGMENTS.md",
        "{workspaceRoot}/ARCHITECTURE.md",
        "{workspaceRoot}/CONTRIBUTING.md",
        "{workspaceRoot}/MANIFESTO.md",
        "{workspaceRoot}/REGARDING_AI.md",
        "{workspaceRoot}/.all-contributorsrc",
        "{workspaceRoot}/assets/media/**",
        "{workspaceRoot}/libs/**/*.md",
        "{workspaceRoot}/libs/**/src/**/*.ts",
        "{workspaceRoot}/libs/**/package.json",
        "{workspaceRoot}/libs/**/project.json",
        "{workspaceRoot}/plugins/**/*.md",
        "{workspaceRoot}/plugins/**/src/**/*.ts"
      ],
      "options": {
        "command": "npm run build"
      }
    },
    "serve": {
      "executor": "@hyperfrontend/app:serve",
      "dependsOn": ["build"],
      "options": {
        "command": "npm run start"
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "inputs": ["dependencyState"],
      "options": {
        "command": "npm audit --audit-level=high",
        "cwd": "apps/docs-site"
      },
      "metadata": {
        "description": "Gated at high instead of the workspace's moderate while typedoc requires minimatch 10 (GHSA-g3hv-75wg-m249, moderate, pattern-driven DoS; every pattern here is repo-controlled). An override to minimatch 11 breaks typedoc, which calls the now-private matchOne. Delete this target so the default applies again once typedoc requires minimatch >=11.0.1."
      }
    }
  }
}

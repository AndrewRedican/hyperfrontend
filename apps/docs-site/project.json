{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "docs-site",
  "description": "Next.js documentation site for hyperfrontend.",
  "sourceRoot": "apps/docs-site/src",
  "projectType": "application",
  "tags": ["type:app", "scope:standalone"],
  "implicitDependencies": ["demo-clock", "demo-heartbeat", "demo-koi-pond"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npx tsc --noEmit",
        "cwd": "apps/docs-site"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "npm run test",
        "cwd": "apps/docs-site"
      }
    },
    "install": {
      "executor": "@hyperfrontend/app:install",
      "options": {}
    },
    "refresh-shell": {
      "executor": "nx:run-commands",
      "dependsOn": ["demo-clock:pack-shell", "demo-heartbeat:pack-shell", "demo-koi-pond:pack-shell"],
      "options": {
        "commands": [
          "cp ../../dist/apps/demos/clock/shell/hyperfrontend-demo-clock-shell-*.tgz vendor/",
          "cp ../../dist/apps/demos/heartbeat/shell/hyperfrontend-demo-heartbeat-shell-*.tgz vendor/",
          "cp ../../dist/apps/demos/koi-pond/shell/hyperfrontend-demo-koi-pond-shell-*.tgz vendor/",
          "node ./scripts/install-vendored-shells.mjs"
        ],
        "cwd": "apps/docs-site",
        "parallel": false
      }
    },
    "build": {
      "executor": "@hyperfrontend/app:build",
      "dependsOn": ["install"],
      "cache": false,
      "inputs": [
        "default",
        "{workspaceRoot}/ACKNOWLEDGMENTS.md",
        "{workspaceRoot}/ARCHITECTURE.md",
        "{workspaceRoot}/CONTRIBUTING.md",
        "{workspaceRoot}/MANIFESTO.md",
        "{workspaceRoot}/REGARDING_AI.md",
        "{workspaceRoot}/.all-contributorsrc",
        "{workspaceRoot}/assets/media/**",
        "{workspaceRoot}/libs/**/*.md",
        "{workspaceRoot}/libs/**/src/**/*.ts",
        "{workspaceRoot}/plugins/**/*.md",
        "{workspaceRoot}/plugins/**/src/**/*.ts"
      ],
      "outputs": ["{projectRoot}/.generated", "{projectRoot}/.next", "{projectRoot}/out"],
      "options": {
        "command": "npm run build"
      }
    },
    "serve": {
      "executor": "@hyperfrontend/app:serve",
      "dependsOn": ["build"],
      "options": {
        "command": "npm run start"
      }
    },
    "audit": {}
  }
}

{
  "name": "@hyperfrontend/docs-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run refresh-downloads -- --deployment && npm run generate && npm run copy-media && npm run validate-links && npm run validate-sitemap && NODE_OPTIONS='--max-old-space-size=4096' next build --webpack",
    "start": "next start --port 3000",
    "copy-media": "npx tsx scripts/copy-media.ts",
    "generate": "npx tsx scripts/generate-docs.ts",
    "generate:guides": "npx tsx scripts/generate-docs.ts --guides-only",
    "refresh-downloads": "npx tsx scripts/refresh-npm-downloads.ts",
    "validate-links": "npx tsx scripts/validate-links.ts",
    "validate-sitemap": "npx tsx scripts/validate-sitemap.ts",
    "check:decision-framework": "node notes/decision-framework/matrix/check-projection.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@hyperfrontend/demo-clock-shell": "file:vendor/hyperfrontend-demo-clock-shell-0.3.0.tgz",
    "@hyperfrontend/demo-heartbeat-shell": "file:vendor/hyperfrontend-demo-heartbeat-shell-0.2.0.tgz",
    "@hyperfrontend/demo-koi-lib": "file:vendor/hyperfrontend-demo-koi-lib-0.1.0.tgz",
    "@hyperfrontend/demo-koi-pond-shell": "file:vendor/hyperfrontend-demo-koi-pond-shell-0.2.0.tgz",
    "@hyperfrontend/function-utils": "1.0.1",
    "@hyperfrontend/immutable-api-utils": "1.0.2",
    "@hyperfrontend/logging": "1.0.1",
    "@hyperfrontend/time-utils": "1.0.1",
    "glob": "10.5.0",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@shikijs/rehype": "4.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "markdown-it": "14.3.3",
    "typedoc": {
      "brace-expansion": "5.0.12"
    },
    "source-map-js": "1.2.2",
    "vite": "8.2.4",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}

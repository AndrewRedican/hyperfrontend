    "@hyperfrontend/function-utils": "0.0.4",
    "@hyperfrontend/immutable-api-utils": "0.1.4",
    "@hyperfrontend/logging": "0.1.1",
    "@hyperfrontend/time-utils": "0.0.4",
    "glob": "10.5.0",
    "mermaid": "11.16.1",

# Loaded by `next dev` only — production builds keep the deployed origin baked
# into the demo manifest. Point the clock embed at the local feature app served
# by `npx nx run demo-clock:dev` (vite build --watch + `hf dev` on this port),
# so the full host-to-hostee wiring is testable before any deploy.
NEXT_PUBLIC_CLOCK_FEATURE_URL=http://localhost:4280/

# Loaded by `next dev` only: production builds keep the deployed origin baked
# into the demo manifest. Point the clock embed at the local feature app served
# by `npm run hf -- run-many -t dev -p demo-clock` (vite build --watch + `hf dev`
# on this port), so the full host-to-hostee wiring is testable before any deploy.
NEXT_PUBLIC_CLOCK_FEATURE_URL=http://localhost:4280/

# Same idea for the heartbeat embed: `npm run hf -- run-many -t dev -p
# demo-heartbeat` serves the feature app on this port.
NEXT_PUBLIC_HEARTBEAT_FEATURE_URL=http://localhost:4281/

# The koi pond deploys as one origin serving the host at `/` and each koi at
# `/fish-<name>/`, so `npm run hf -- run-many -t dev-hosted -p demo-koi-pond`
# serves the whole composed site on this port and the fish resolve as
# same-origin sub-paths.
NEXT_PUBLIC_KOI_POND_FEATURE_URL=http://localhost:4282/

# Analytics stays off locally: NEXT_PUBLIC_GA_MEASUREMENT_ID is only configured
# in the production Vercel environment. Uncomment with a test property to
# exercise the cookieless GA flow locally.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=

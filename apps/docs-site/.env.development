# Loaded by `next dev` only — production builds keep the deployed origin baked
# into the demo manifest. Point the clock embed at the local feature app served
# by `npx nx run demo-clock:dev` (vite build --watch + `hf dev` on this port),
# so the full host-to-hostee wiring is testable before any deploy.
NEXT_PUBLIC_CLOCK_FEATURE_URL=http://localhost:4280/

# Same idea for the heartbeat embed: `npx nx run demo-heartbeat:dev` serves the
# feature app on this port.
NEXT_PUBLIC_HEARTBEAT_FEATURE_URL=http://localhost:4281/

# Analytics stays off locally: NEXT_PUBLIC_GA_MEASUREMENT_ID is only configured
# in the production Vercel environment. Uncomment with a test property to
# exercise the cookieless GA flow locally.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GOOGLE_ADS_ID=

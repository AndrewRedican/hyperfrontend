{
  "name": "e2e-lib-features",
  "description": "E2E tests for @hyperfrontend/features package outputs",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "application",
  "tags": ["type:e2e", "scope:internal"],
  "targets": {
    "e2e": {
      "executor": "@hyperfrontend/workspace:e2e",
      "dependsOn": ["^build"],
      "options": {
        "formats": [
          "cjs",
          "esm",
          "browser",
          {
            "name": "cli",
            "specs": ["src/cli.spec.ts"]
          },
          {
            "name": "nx",
            "specs": ["src/nx-plugin.spec.ts", "src/nx-plugin-callbacks.spec.ts", "src/nx-types.spec.ts"],
            "timeoutMs": 900000,
            "serialOn": ["win32"]
          }
        ]
      }
    },
    "audit": {}
  },
  "implicitDependencies": ["lib-features", "lib-integration-nx"]
}

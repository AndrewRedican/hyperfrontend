{
  "name": "e2e-lib-server",
  "description": "E2E tests for @hyperfrontend/server package outputs",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "application",
  "tags": ["type:e2e", "scope:internal"],
  "targets": {
    "e2e": {
      "executor": "@hyperfrontend/workspace:e2e",
      "dependsOn": ["^build"],
      "options": {
        "formats": [
          "cjs",
          "esm",
          { "name": "service", "specs": ["src/service.spec.ts", "src/service.sealed.spec.ts"], "timeoutMs": 120000 }
        ]
      }
    },
    "audit": {}
  },
  "implicitDependencies": ["lib-server"]
}
